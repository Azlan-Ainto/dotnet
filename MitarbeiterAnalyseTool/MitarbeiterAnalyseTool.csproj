<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<Authors>Azlan Ainto</Authors>
	<Company>Techsoft Westfalen</Company>
	<Product>MitarbeiterAnalyseTool</Product>
	<Description> 
		Konsolenanwendung zur Verwaltung und Analyse von Mitarbeiterdaten.
	</Description>
	<Copyright>© 2026 Azlan Ainto</Copyright>
	<PackageIcon></PackageIcon>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
